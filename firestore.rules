rules_version = '2';

// Aplikasi berjalan tanpa login, jadi rules berfungsi sebagai validasi data:
// bentuk dokumen, rentang nilai, dan konsistensi antar dokumen.
// Ruangan bertumpuk dicegah di aplikasi (rules tidak bisa membandingkan antar dokumen).
service cloud.firestore {
  match /databases/{database}/documents {

    function countersAfter() {
      return getAfter(/databases/$(database)/documents/meta/counters).data;
    }

    function roomDoc(id) {
      return get(/databases/$(database)/documents/rooms/$(string(id)));
    }

    // Kelipatan grid 0,5 m
    function onGrid(v) {
      return v is number && v * 2 == math.floor(v * 2);
    }

    function validRoom(data, roomId) {
      return data.keys().hasOnly(['id', 'nama_ruangan', 'nama_key', 'tipe', 'lantai_id',
                                  'x', 'y', 'w', 'h', 'luas', 'kapasitas_max', 'occupancy',
                                  'created_at', 'updated_at'])
        && data.id is int && string(data.id) == roomId
        && data.nama_ruangan is string
        && data.nama_ruangan.size() > 0 && data.nama_ruangan.size() <= 60
        && data.nama_key == data.nama_ruangan.lower()
        && data.tipe in ['ruangan', 'lorong', 'tangga', 'lift', 'luar']
        && data.lantai_id is int
        && exists(/databases/$(database)/documents/floors/$(string(data.lantai_id)))
        && onGrid(data.x) && onGrid(data.y) && onGrid(data.w) && onGrid(data.h)
        && data.w >= 1 && data.h >= 1 && data.w <= 500 && data.h <= 500
        && math.abs(data.x) <= 500 && math.abs(data.y) <= 500
        && data.luas == data.w * data.h
        && data.kapasitas_max is int && data.kapasitas_max > 0 && data.kapasitas_max <= 1000
        && data.occupancy is int && data.occupancy >= 0 && data.occupancy <= data.kapasitas_max
        && data.updated_at == request.time;
    }

    function officeExists(id) {
      return id is int && exists(/databases/$(database)/documents/offices/$(string(id)));
    }

    // Kantor (gedung). Isinya: lantai → ruangan → pintu & elemen.
    match /offices/{officeId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id', 'nama', 'alamat', 'created_at'])
        && request.resource.data.id is int && string(request.resource.data.id) == officeId
        && validOffice(request.resource.data)
        && request.resource.data.created_at == request.time
        && countersAfter().offices == request.resource.data.id;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'alamat'])
        && validOffice(request.resource.data);
      allow delete: if true;
    }

    function validOffice(o) {
      return o.nama is string && o.nama.size() > 0 && o.nama.size() <= 60
        && o.alamat is string && o.alamat.size() <= 120;
    }

    match /floors/{floorId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id', 'office_id', 'nama', 'created_at'])
        && request.resource.data.id is int && string(request.resource.data.id) == floorId
        && officeExists(request.resource.data.office_id)
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0 && request.resource.data.nama.size() <= 40
        && request.resource.data.created_at == request.time
        && countersAfter().floors == request.resource.data.id;
      // Ganti nama, atau pindah/tetapkan kantor (termasuk lantai lama yang belum punya kantor)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'office_id'])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0 && request.resource.data.nama.size() <= 40
        && officeExists(request.resource.data.office_id);
      allow delete: if true;
    }

    match /rooms/{roomId} {
      allow read: if true;

      // ID baru harus sama dengan counter yang dinaikkan dalam transaksi yang sama
      allow create: if validRoom(request.resource.data, roomId)
        && request.resource.data.occupancy == 0
        && request.resource.data.created_at == request.time
        && countersAfter().rooms == request.resource.data.id;

      allow update: if validRoom(request.resource.data, roomId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.lantai_id == resource.data.lantai_id
        && request.resource.data.created_at == resource.data.created_at;

      allow delete: if true;
    }

    // Pintu antar ruangan (room_from < room_to). Satu pasangan boleh punya beberapa pintu.
    // Satu lantai: offset (m) di dinding bersama, swing_into = ruangan tempat daun pintu membuka,
    // hinge = 'start' | 'end'. Beda lantai: penghubung tangga/lift dengan field pintu bernilai null.
    // Tabrakan antar pintu dicek di aplikasi.
    match /doors/{doorId} {
      allow read, delete: if true;

      allow create: if request.resource.data.keys().hasOnly(['room_from', 'room_to', 'jenis', 'offset',
                                                              'swing_into', 'hinge', 'created_at'])
        && request.resource.data.room_from is int
        && request.resource.data.room_to is int
        && request.resource.data.room_from < request.resource.data.room_to
        && request.resource.data.created_at == request.time
        && validDoor(request.resource.data,
                     roomDoc(request.resource.data.room_from).data,
                     roomDoc(request.resource.data.room_to).data);

      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['jenis', 'offset', 'swing_into', 'hinge'])
        && validDoor(request.resource.data,
                     roomDoc(resource.data.room_from).data,
                     roomDoc(resource.data.room_to).data);
    }

    function validDoor(door, a, b) {
      return (a.lantai_id == b.lantai_id
              && door.offset is number && door.offset >= 0 && door.offset <= 500
              && door.get('swing_into', door.room_to) in [door.room_from, door.room_to]
              && door.get('hinge', 'start') in ['start', 'end']
              && door.get('jenis', 'tunggal') in ['tunggal', 'ganda', 'geser', 'bukaan'])
        || (a.lantai_id != b.lantai_id
            && door.offset == null
            && door.get('swing_into', null) == null && door.get('hinge', null) == null
            && door.get('jenis', null) == null
            && a.tipe in ['tangga', 'lift'] && b.tipe in ['tangga', 'lift']);
    }

    // Elemen gambar: jendela (di sisi ruangan), kolom (bebas), furnitur (di dalam ruangan).
    // Posisi furnitur relatif terhadap ruangannya; tumpang-tindih dicek di aplikasi.
    match /elements/{elementId} {
      allow read, delete: if true;
      allow create: if validElement(request.resource.data)
        && request.resource.data.created_at == request.time;
      allow update: if validElement(request.resource.data)
        && request.resource.data.jenis == resource.data.jenis
        && request.resource.data.lantai_id == resource.data.lantai_id
        && request.resource.data.get('room_id', null) == resource.data.get('room_id', null)
        && request.resource.data.created_at == resource.data.created_at;
    }

    function inRange(v, min, max) {
      return v is number && v >= min && v <= max;
    }

    function validElement(e) {
      return e.lantai_id is int
        && exists(/databases/$(database)/documents/floors/$(string(e.lantai_id)))
        && (
          (e.jenis == 'jendela'
            && e.keys().hasOnly(['jenis', 'lantai_id', 'room_id', 'sisi', 'offset', 'lebar', 'created_at'])
            && e.room_id is int && roomDoc(e.room_id).data.lantai_id == e.lantai_id
            && e.sisi in ['atas', 'bawah', 'kiri', 'kanan']
            && (e.offset == null || inRange(e.offset, 0, 500))
            && inRange(e.lebar, 0.4, 10))
          || (e.jenis == 'kolom'
            && e.keys().hasOnly(['jenis', 'lantai_id', 'x', 'y', 'w', 'h', 'created_at'])
            && inRange(e.x, -500, 500) && inRange(e.y, -500, 500)
            && inRange(e.w, 0.1, 3) && inRange(e.h, 0.1, 3))
          || (e.jenis == 'furnitur'
            && e.keys().hasOnly(['jenis', 'lantai_id', 'room_id', 'model', 'x', 'y', 'rotasi', 'created_at'])
            && e.room_id is int && roomDoc(e.room_id).data.lantai_id == e.lantai_id
            && e.model is string && e.model.size() > 0 && e.model.size() <= 40
            && inRange(e.x, 0, 500) && inRange(e.y, 0, 500)
            && e.rotasi in [0, 90, 180, 270])
        );
    }

    // Counter ID hanya boleh naik satu per satu
    match /meta/counters {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['rooms', 'floors', 'offices'])
        && request.resource.data.get('rooms', 0) in [0, 1]
        && request.resource.data.get('floors', 0) in [0, 1]
        && request.resource.data.get('offices', 0) in [0, 1];
      allow update: if request.resource.data.keys().hasOnly(['rooms', 'floors', 'offices'])
        && stepsByOne('rooms') && stepsByOne('floors') && stepsByOne('offices');
      allow delete: if false;
    }

    function stepsByOne(key) {
      return request.resource.data.get(key, 0) == resource.data.get(key, 0)
        || request.resource.data.get(key, 0) == resource.data.get(key, 0) + 1;
    }
  }
}
